// XelSSL - arithmetic modulo p = 2^255 - 19 (X25519, Ed25519).
//
// Two implementations behind one interface:
// - Pascal (every platform): 10 signed limbs of 25.5 bits in Int64, so that all
//   products fit into 64 bits (multiplication generated by test/gen_fe25519.py);
// - x86-64 assembler addition: 5 limbs of 51 bits, products with MUL (64 x 64 -> 128).
// FeSelect chooses the implementation; a whole operation (one X25519, one signature)
// must run with one choice, so the callers call FeSelect at their start.
// All operations are constant time (no branches or table lookups on secret data).
// License: MIT.
unit XelSslFe25519;

{$mode objfpc}{$H+}{$Q-}{$R-}
{$IFDEF CPUX86_64}
  {$asmmode intel}
  {$DEFINE XELSSL_X64}
{$ENDIF}

interface

type
  TFe = array[0..9] of Int64;               // 10 x 25.5 bits, or 5 x 51 bits (first 5)

var
  // use the assembler addition when the CPU allows it (tests switch it off)
  FeUseAsm: Boolean = True;

// Chooses the implementation for the following operations (call once per operation).
procedure FeSelect;
// True if the 51-bit (assembler) implementation is selected.
function FeIs51: Boolean;

procedure FeFromBytes(out h: TFe; S: PByte);         // 32 bytes little-endian, top bit ignored
procedure FeToBytes(S: PByte; const h: TFe);         // canonical value mod p, 32 bytes
procedure FeZero(out h: TFe);
procedure FeOne(out h: TFe);
procedure FeAdd(out h: TFe; const f, g: TFe);
procedure FeSub(out h: TFe; const f, g: TFe);
procedure FeNeg(out h: TFe; const f: TFe);
procedure FeMul(out h: TFe; const f, g: TFe);
procedure FeSq(out h: TFe; const f: TFe);
procedure FeInv(out h: TFe; const z: TFe);           // z^(p-2)
procedure FePow22523(out h: TFe; const z: TFe);      // z^((p-5)/8), for square roots
procedure FeCSwap(var f, g: TFe; B: Integer);        // swap if B = 1
function FeIsZero(const f: TFe): Boolean;
function FeIsNegative(const f: TFe): Integer;        // lowest bit of the canonical value

implementation

uses XelSslCpu;

var
  G51: Boolean = False;

const
  M26 = (Int64(1) shl 26) - 1;
  M25 = (Int64(1) shl 25) - 1;
  M51 = (UInt64(1) shl 51) - 1;

procedure FeSelect;
begin
  {$IFDEF XELSSL_X64}
  G51 := FeUseAsm and AsmAvailable([cfSse2]);
  {$ELSE}
  G51 := False;
  {$ENDIF}
end;

function FeIs51: Boolean;
begin
  Result := G51;
end;

// ================= Pascal: 10 x 25.5 bits =================

// carries every limb into the next one (floor division, works for negative limbs);
// afterwards limbs 0 and 2..9 are in [0, 2^bits), limb 1 below 2^25 + 2^16
procedure FeCarry10(var h0, h1, h2, h3, h4, h5, h6, h7, h8, h9: Int64); inline;
var c: Int64;
begin
  c := SarInt64(h0, 26); h1 := h1 + c; h0 := h0 and M26;
  c := SarInt64(h1, 25); h2 := h2 + c; h1 := h1 and M25;
  c := SarInt64(h2, 26); h3 := h3 + c; h2 := h2 and M26;
  c := SarInt64(h3, 25); h4 := h4 + c; h3 := h3 and M25;
  c := SarInt64(h4, 26); h5 := h5 + c; h4 := h4 and M26;
  c := SarInt64(h5, 25); h6 := h6 + c; h5 := h5 and M25;
  c := SarInt64(h6, 26); h7 := h7 + c; h6 := h6 and M26;
  c := SarInt64(h7, 25); h8 := h8 + c; h7 := h7 and M25;
  c := SarInt64(h8, 26); h9 := h9 + c; h8 := h8 and M26;
  c := SarInt64(h9, 25); h0 := h0 + 19 * c; h9 := h9 and M25;
  c := SarInt64(h0, 26); h1 := h1 + c; h0 := h0 and M26;
end;

procedure Carry25(var h: TFe); inline;
begin
  FeCarry10(h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8], h[9]);
end;

{$I XelSslFe25519Mul.inc}

// limb i of the 255-bit little-endian number in S (Start bit, Count bits)
function Bits(S: PByte; Start, Count: Integer): Int64;
var i: Integer;
begin
  Result := 0;
  for i := Count - 1 downto 0 do
    Result := (Result shl 1) or ((S[(Start + i) shr 3] shr ((Start + i) and 7)) and 1);
end;

const
  W25: array[0..9] of Integer = (0, 26, 51, 77, 102, 128, 153, 179, 204, 230);
  B25: array[0..9] of Integer = (26, 25, 26, 25, 26, 25, 26, 25, 26, 25);

// little-endian 32 bytes from limbs that are all >= 0 and in range (value < 2^255)
procedure PackBits(S: PByte; const L: array of Int64; const W, B: array of Integer);
var i, k: Integer; v: Int64;
begin
  FillChar(S^, 32, 0);
  for i := 0 to High(L) do
  begin
    v := L[i];
    for k := 0 to B[i] - 1 do
      S[(W[i] + k) shr 3] := S[(W[i] + k) shr 3] or Byte(((v shr k) and 1) shl ((W[i] + k) and 7));
  end;
end;

// Limbs >= 0 with V = sum L[i]*2^W[i] < 2^256 - 19 -> V mod p with every limb exactly in
// its bit range (constant time): q = floor((V + 19) / 2^255) is 1 exactly when V >= p;
// then V + 19q with the carry out of the top limb (q * 2^255) dropped equals V - q*p.
procedure Reduce(var L: array of Int64; const B: array of Integer);
var i: Integer; c: Int64;
begin
  c := 19;
  for i := 0 to High(L) do c := SarInt64(L[i] + c, B[i]);
  L[0] := L[0] + 19 * c;
  for i := 0 to High(L) - 1 do
  begin
    c := SarInt64(L[i], B[i]);
    L[i + 1] := L[i + 1] + c;
    L[i] := L[i] and ((Int64(1) shl B[i]) - 1);
  end;
  L[High(L)] := L[High(L)] and ((Int64(1) shl B[High(L)]) - 1);
end;

// ================= assembler: 5 x 51 bits =================

const
  W51: array[0..4] of Integer = (0, 51, 102, 153, 204);
  B51: array[0..4] of Integer = (51, 51, 51, 51, 51);

procedure Carry51(var h: TFe); inline;
var c: UInt64;
begin
  c := UInt64(h[0]) shr 51; h[1] := h[1] + Int64(c); h[0] := Int64(UInt64(h[0]) and M51);
  c := UInt64(h[1]) shr 51; h[2] := h[2] + Int64(c); h[1] := Int64(UInt64(h[1]) and M51);
  c := UInt64(h[2]) shr 51; h[3] := h[3] + Int64(c); h[2] := Int64(UInt64(h[2]) and M51);
  c := UInt64(h[3]) shr 51; h[4] := h[4] + Int64(c); h[3] := Int64(UInt64(h[3]) and M51);
  c := UInt64(h[4]) shr 51; h[0] := h[0] + Int64(19 * c); h[4] := Int64(UInt64(h[4]) and M51);
  c := UInt64(h[0]) shr 51; h[1] := h[1] + Int64(c); h[0] := Int64(UInt64(h[0]) and M51);
end;

{$IFDEF XELSSL_X64}
// h = f * g mod p; limbs below 2^52 in, below 2^51 + 2^14 out. The 25 products of
// 64 x 64 bits are summed per output limb in 128 bits (f_i*g_j*19 for i + j >= 5).
procedure Mul51(out h: TFe; const f, g: TFe);
var ph, pf, pg, pt: Pointer; t: array[0..9] of UInt64;
begin
  ph := @h; pf := @f; pg := @g; pt := @t[0];
  asm
    mov rax, pf
    mov rcx, pg
    mov rdx, pt
    mov r8, ph
    push rbx
    push rsi
    push rdi
    push r12
    push r13
    push r14
    push r15
    push r8
    mov rsi, rax
    mov rdi, rcx
    mov rbx, rdx
    imul r8, qword ptr [rdi + 8], 19
    imul r9, qword ptr [rdi + 16], 19
    imul r10, qword ptr [rdi + 24], 19
    imul r11, qword ptr [rdi + 32], 19
    // t0 = f0 g0 + f1 g4*19 + f2 g3*19 + f3 g2*19 + f4 g1*19
    mov rax, [rsi]
    mul qword ptr [rdi]
    mov r12, rax
    mov r13, rdx
    mov rax, [rsi + 8]
    mul r11
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 16]
    mul r10
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 24]
    mul r9
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 32]
    mul r8
    add r12, rax
    adc r13, rdx
    mov [rbx], r12
    mov [rbx + 8], r13
    // t1 = f0 g1 + f1 g0 + f2 g4*19 + f3 g3*19 + f4 g2*19
    mov rax, [rsi]
    mul qword ptr [rdi + 8]
    mov r12, rax
    mov r13, rdx
    mov rax, [rsi + 8]
    mul qword ptr [rdi]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 16]
    mul r11
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 24]
    mul r10
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 32]
    mul r9
    add r12, rax
    adc r13, rdx
    mov [rbx + 16], r12
    mov [rbx + 24], r13
    // t2 = f0 g2 + f1 g1 + f2 g0 + f3 g4*19 + f4 g3*19
    mov rax, [rsi]
    mul qword ptr [rdi + 16]
    mov r12, rax
    mov r13, rdx
    mov rax, [rsi + 8]
    mul qword ptr [rdi + 8]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 16]
    mul qword ptr [rdi]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 24]
    mul r11
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 32]
    mul r10
    add r12, rax
    adc r13, rdx
    mov [rbx + 32], r12
    mov [rbx + 40], r13
    // t3 = f0 g3 + f1 g2 + f2 g1 + f3 g0 + f4 g4*19
    mov rax, [rsi]
    mul qword ptr [rdi + 24]
    mov r12, rax
    mov r13, rdx
    mov rax, [rsi + 8]
    mul qword ptr [rdi + 16]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 16]
    mul qword ptr [rdi + 8]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 24]
    mul qword ptr [rdi]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 32]
    mul r11
    add r12, rax
    adc r13, rdx
    mov [rbx + 48], r12
    mov [rbx + 56], r13
    // t4 = f0 g4 + f1 g3 + f2 g2 + f3 g1 + f4 g0
    mov rax, [rsi]
    mul qword ptr [rdi + 32]
    mov r12, rax
    mov r13, rdx
    mov rax, [rsi + 8]
    mul qword ptr [rdi + 24]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 16]
    mul qword ptr [rdi + 16]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 24]
    mul qword ptr [rdi + 8]
    add r12, rax
    adc r13, rdx
    mov rax, [rsi + 32]
    mul qword ptr [rdi]
    add r12, rax
    adc r13, rdx
    mov [rbx + 64], r12
    mov [rbx + 72], r13
    // carries: limb k = low 51 bits, (t_k >> 51) goes to t_(k+1); t_4 >> 51 times 19 to limb 0
    mov r14, $7FFFFFFFFFFFF
    mov r12, [rbx]
    mov r13, [rbx + 8]
    mov rax, r12
    shrd rax, r13, 51
    and r12, r14
    mov r15, r12
    mov r12, [rbx + 16]
    mov r13, [rbx + 24]
    add r12, rax
    adc r13, 0
    mov rax, r12
    shrd rax, r13, 51
    and r12, r14
    mov r8, r12
    mov r12, [rbx + 32]
    mov r13, [rbx + 40]
    add r12, rax
    adc r13, 0
    mov rax, r12
    shrd rax, r13, 51
    and r12, r14
    mov r9, r12
    mov r12, [rbx + 48]
    mov r13, [rbx + 56]
    add r12, rax
    adc r13, 0
    mov rax, r12
    shrd rax, r13, 51
    and r12, r14
    mov r10, r12
    mov r12, [rbx + 64]
    mov r13, [rbx + 72]
    add r12, rax
    adc r13, 0
    mov rax, r12
    shrd rax, r13, 51
    and r12, r14
    mov r11, r12
    imul rax, rax, 19
    add r15, rax
    mov rax, r15
    shr rax, 51
    and r15, r14
    add r8, rax
    pop rax
    mov [rax], r15
    mov [rax + 8], r8
    mov [rax + 16], r9
    mov [rax + 24], r10
    mov [rax + 32], r11
    pop r15
    pop r14
    pop r13
    pop r12
    pop rdi
    pop rsi
    pop rbx
  end ['rax', 'rcx', 'rdx', 'r8', 'r9', 'r10', 'r11'];
  FillChar(t, SizeOf(t), 0);
end;
{$ENDIF}

// ================= common interface =================

procedure FeZero(out h: TFe);
begin
  FillChar(h, SizeOf(h), 0);
end;

procedure FeOne(out h: TFe);
begin
  FillChar(h, SizeOf(h), 0);
  h[0] := 1;
end;

procedure FeFromBytes(out h: TFe; S: PByte);
var i: Integer;
begin
  FillChar(h, SizeOf(h), 0);
  if G51 then
    for i := 0 to 4 do h[i] := Bits(S, W51[i], 51)
  else
    for i := 0 to 9 do h[i] := Bits(S, W25[i], B25[i]);
end;

procedure FeToBytes(S: PByte; const h: TFe);
var t: TFe; i: Integer;
begin
  t := h;
  if G51 then
  begin
    for i := 1 to 2 do Carry51(t);
    Reduce(t[0..4], B51);
    PackBits(S, t[0..4], W51, B51);
  end
  else
  begin
    for i := 1 to 2 do Carry25(t);
    Reduce(t, B25);
    PackBits(S, t, W25, B25);
  end;
  FillChar(t, SizeOf(t), 0);
end;

procedure FeAdd(out h: TFe; const f, g: TFe);
var i: Integer;
begin
  for i := 0 to 9 do h[i] := f[i] + g[i];
  if G51 then Carry51(h) else Carry25(h);
end;

procedure FeSub(out h: TFe; const f, g: TFe);
var i: Integer;
begin
  if G51 then
  begin
    // f + 2p - g keeps the 51-bit limbs non-negative (g limbs < 2^51 + 2^14)
    h[0] := f[0] + Int64((UInt64(1) shl 52) - 38) - g[0];
    for i := 1 to 4 do h[i] := f[i] + Int64((UInt64(1) shl 52) - 2) - g[i];
    for i := 5 to 9 do h[i] := 0;
    Carry51(h);
  end
  else
  begin
    for i := 0 to 9 do h[i] := f[i] - g[i];
    Carry25(h);
  end;
end;

procedure FeNeg(out h: TFe; const f: TFe);
var z: TFe;
begin
  FeZero(z);
  FeSub(h, z, f);
end;

procedure FeMul(out h: TFe; const f, g: TFe);
begin
  {$IFDEF XELSSL_X64}
  if G51 then begin Mul51(h, f, g); Exit; end;
  {$ENDIF}
  Mul25(h, f, g);
end;

procedure FeSq(out h: TFe; const f: TFe);
begin
  {$IFDEF XELSSL_X64}
  if G51 then begin Mul51(h, f, f); Exit; end;
  {$ENDIF}
  Sq25(h, f);
end;

procedure SqN(var h: TFe; N: Integer);
var i: Integer;
begin
  for i := 1 to N do FeSq(h, h);
end;

// z^(2^250 - 1) and z^11 (shared part of the inversion chains)
procedure Pow250(out r250, z11: TFe; const z: TFe);
var t0, t1, t2, t3: TFe;
begin
  FeSq(t0, z);                                // z^2
  t1 := t0; SqN(t1, 2);                       // z^8
  FeMul(t1, t1, z);                           // z^9
  FeMul(t0, t0, t1);                          // z^11
  z11 := t0;
  FeSq(t2, t0);                               // z^22
  FeMul(t1, t1, t2);                          // z^(2^5 - 1)
  t2 := t1; SqN(t2, 5); FeMul(t1, t2, t1);    // z^(2^10 - 1)
  t2 := t1; SqN(t2, 10); FeMul(t2, t2, t1);   // z^(2^20 - 1)
  t3 := t2; SqN(t3, 20); FeMul(t2, t3, t2);   // z^(2^40 - 1)
  SqN(t2, 10); FeMul(t1, t2, t1);             // z^(2^50 - 1)
  t2 := t1; SqN(t2, 50); FeMul(t2, t2, t1);   // z^(2^100 - 1)
  t3 := t2; SqN(t3, 100); FeMul(t2, t3, t2);  // z^(2^200 - 1)
  SqN(t2, 50); FeMul(r250, t2, t1);           // z^(2^250 - 1)
end;

procedure FeInv(out h: TFe; const z: TFe);
var r, z11: TFe;
begin
  Pow250(r, z11, z);
  SqN(r, 5);                                  // z^(2^255 - 2^5)
  FeMul(h, r, z11);                           // z^(2^255 - 21) = z^(p - 2)
end;

procedure FePow22523(out h: TFe; const z: TFe);
var r, z11: TFe;
begin
  Pow250(r, z11, z);
  SqN(r, 2);                                  // z^(2^252 - 4)
  FeMul(h, r, z);                             // z^(2^252 - 3)
end;

procedure FeCSwap(var f, g: TFe; B: Integer);
var i: Integer; m, t: Int64;
begin
  m := -Int64(B and 1);
  for i := 0 to 9 do
  begin
    t := m and (f[i] xor g[i]);
    f[i] := f[i] xor t;
    g[i] := g[i] xor t;
  end;
end;

function FeIsZero(const f: TFe): Boolean;
var s: array[0..31] of Byte; i: Integer; d: Byte;
begin
  FeToBytes(@s[0], f);
  d := 0;
  for i := 0 to 31 do d := d or s[i];
  Result := d = 0;
end;

function FeIsNegative(const f: TFe): Integer;
var s: array[0..31] of Byte;
begin
  FeToBytes(@s[0], f);
  Result := s[0] and 1;
end;

end.
