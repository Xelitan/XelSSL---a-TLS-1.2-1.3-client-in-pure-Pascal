const
  // pshufb mask: big-endian 32-bit words
  BeWords: array[0..15] of Byte = (3, 2, 1, 0, 7, 6, 5, 4, 11, 10, 9, 8, 15, 14, 13, 12);

// N blocks of SHA-256 with the SHA extensions (SHA-NI). The state is kept as ABEF / CDGH
// as SHA256RNDS2 expects; xmm6..xmm9 are saved (callee-saved on Win64).
procedure HwSha256(H: PUInt32; P: PByte; N: Integer);
var ph, pp, pm, pk, psave: Pointer; cnt: PtrInt; save: array[0..63] of Byte;
begin
  ph := H; pp := P; cnt := N; pm := @BeWords; pk := @K256; psave := @save[0];
  asm
    mov rax, psave
    movdqu [rax], xmm6
    movdqu [rax + 16], xmm7
    movdqu [rax + 32], xmm8
    movdqu [rax + 48], xmm9
    mov rcx, ph
    mov r8, pp
    mov r9, cnt
    mov r10, pm
    mov r11, pk
    // H0..H7 -> ABEF, CDGH
    movdqu xmm1, [rcx]
    movdqu xmm2, [rcx + 16]
    pshufd xmm1, xmm1, $B1
    pshufd xmm2, xmm2, $1B
    movdqa xmm7, xmm1
    palignr xmm1, xmm2, 8
    pblendw xmm2, xmm7, $F0
  @blk:
    test r9, r9
    jz @done
    movdqa xmm8, xmm1
    movdqa xmm9, xmm2
    movdqu xmm3, [r8 + 0]
    pshufb xmm3, [r10]
    movdqa xmm0, xmm3
    paddd xmm0, [r11 + 0]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    movdqu xmm4, [r8 + 16]
    pshufb xmm4, [r10]
    movdqa xmm0, xmm4
    paddd xmm0, [r11 + 16]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    movdqu xmm5, [r8 + 32]
    pshufb xmm5, [r10]
    movdqa xmm0, xmm5
    paddd xmm0, [r11 + 32]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    movdqu xmm6, [r8 + 48]
    pshufb xmm6, [r10]
    movdqa xmm0, xmm6
    paddd xmm0, [r11 + 48]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    db $0F, $38, $CC, $DC                 // sha256msg1 xmm3, xmm4
    movdqa xmm7, xmm6
    palignr xmm7, xmm5, 4
    paddd xmm3, xmm7
    db $0F, $38, $CD, $DE                 // sha256msg2 xmm3, xmm6
    movdqa xmm0, xmm3
    paddd xmm0, [r11 + 64]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    db $0F, $38, $CC, $E5                 // sha256msg1 xmm4, xmm5
    movdqa xmm7, xmm3
    palignr xmm7, xmm6, 4
    paddd xmm4, xmm7
    db $0F, $38, $CD, $E3                 // sha256msg2 xmm4, xmm3
    movdqa xmm0, xmm4
    paddd xmm0, [r11 + 80]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
