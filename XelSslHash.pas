    movdqa xmm0, xmm4
    paddd xmm0, [r11 + 144]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    db $0F, $38, $CC, $EE                 // sha256msg1 xmm5, xmm6
    movdqa xmm7, xmm4
    palignr xmm7, xmm3, 4
    paddd xmm5, xmm7
    db $0F, $38, $CD, $EC                 // sha256msg2 xmm5, xmm4
    movdqa xmm0, xmm5
    paddd xmm0, [r11 + 160]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
    pshufd xmm0, xmm0, $0E
    db $0F, $38, $CB, $CA                 // sha256rnds2 xmm1, xmm2
    db $0F, $38, $CC, $F3                 // sha256msg1 xmm6, xmm3
    movdqa xmm7, xmm5
    palignr xmm7, xmm4, 4
    paddd xmm6, xmm7
    db $0F, $38, $CD, $F5                 // sha256msg2 xmm6, xmm5
    movdqa xmm0, xmm6
    paddd xmm0, [r11 + 176]
    db $0F, $38, $CB, $D1                 // sha256rnds2 xmm2, xmm1
