function Ror32(X: UInt32; N: Integer): UInt32; inline;
begin Result := (X shr N) or (X shl (32 - N)); end;

function Rol32(X: UInt32; N: Integer): UInt32; inline;
begin Result := (X shl N) or (X shr (32 - N)); end;

function Ror64(X: UInt64; N: Integer): UInt64; inline;
begin Result := (X shr N) or (X shl (64 - N)); end;

function BE32(P: PByte): UInt32; inline;
begin Result := (UInt32(P[0]) shl 24) or (UInt32(P[1]) shl 16) or (UInt32(P[2]) shl 8) or P[3]; end;

function BE64(P: PByte): UInt64; inline;
begin Result := (UInt64(BE32(P)) shl 32) or BE32(P + 4); end;

// ---- blocks ----

procedure Sha1Block(var C: TXHash; P: PByte);
var W: array[0..79] of UInt32; a, b, cc, d, e, t, f, k: UInt32; i: Integer;
begin
  for i := 0 to 15 do W[i] := BE32(P + i * 4);
  for i := 16 to 79 do W[i] := Rol32(W[i-3] xor W[i-8] xor W[i-14] xor W[i-16], 1);
  a := C.H32[0]; b := C.H32[1]; cc := C.H32[2]; d := C.H32[3]; e := C.H32[4];
  for i := 0 to 79 do
  begin
    if i < 20 then begin f := (b and cc) or ((not b) and d); k := K1[0]; end
    else if i < 40 then begin f := b xor cc xor d; k := K1[1]; end
    else if i < 60 then begin f := (b and cc) or (b and d) or (cc and d); k := K1[2]; end
    else begin f := b xor cc xor d; k := K1[3]; end;
    t := Rol32(a, 5) + f + e + k + W[i];
    e := d; d := cc; cc := Rol32(b, 30); b := a; a := t;
  end;
  Inc(C.H32[0], a); Inc(C.H32[1], b); Inc(C.H32[2], cc); Inc(C.H32[3], d); Inc(C.H32[4], e);
end;

procedure Sha256Block(var C: TXHash; P: PByte);
var W: array[0..63] of UInt32; a, b, cc, d, e, f, g, h, t1, t2: UInt32; i: Integer;
begin
  for i := 0 to 15 do W[i] := BE32(P + i * 4);
  for i := 16 to 63 do
    W[i] := (Ror32(W[i-2], 17) xor Ror32(W[i-2], 19) xor (W[i-2] shr 10)) + W[i-7] +
            (Ror32(W[i-15], 7) xor Ror32(W[i-15], 18) xor (W[i-15] shr 3)) + W[i-16];
  a := C.H32[0]; b := C.H32[1]; cc := C.H32[2]; d := C.H32[3];
  e := C.H32[4]; f := C.H32[5]; g := C.H32[6]; h := C.H32[7];
  // 8 rounds per iteration: instead of moving the 8 variables, their roles rotate
  i := 0;
  while i < 64 do
  begin
    h := h + (Ror32(e, 6) xor Ror32(e, 11) xor Ror32(e, 25)) + ((e and f) xor ((not e) and g)) + K256[i + 0] + W[i + 0];
    d := d + h;
    h := h + (Ror32(a, 2) xor Ror32(a, 13) xor Ror32(a, 22)) + ((a and b) xor (a and cc) xor (b and cc));
    g := g + (Ror32(d, 6) xor Ror32(d, 11) xor Ror32(d, 25)) + ((d and e) xor ((not d) and f)) + K256[i + 1] + W[i + 1];
    cc := cc + g;
    g := g + (Ror32(h, 2) xor Ror32(h, 13) xor Ror32(h, 22)) + ((h and a) xor (h and b) xor (a and b));
    f := f + (Ror32(cc, 6) xor Ror32(cc, 11) xor Ror32(cc, 25)) + ((cc and d) xor ((not cc) and e)) + K256[i + 2] + W[i + 2];
    b := b + f;
    f := f + (Ror32(g, 2) xor Ror32(g, 13) xor Ror32(g, 22)) + ((g and h) xor (g and a) xor (h and a));
    e := e + (Ror32(b, 6) xor Ror32(b, 11) xor Ror32(b, 25)) + ((b and cc) xor ((not b) and d)) + K256[i + 3] + W[i + 3];
    a := a + e;
    e := e + (Ror32(f, 2) xor Ror32(f, 13) xor Ror32(f, 22)) + ((f and g) xor (f and h) xor (g and h));
    d := d + (Ror32(a, 6) xor Ror32(a, 11) xor Ror32(a, 25)) + ((a and b) xor ((not a) and cc)) + K256[i + 4] + W[i + 4];
    h := h + d;
    d := d + (Ror32(e, 2) xor Ror32(e, 13) xor Ror32(e, 22)) + ((e and f) xor (e and g) xor (f and g));
    cc := cc + (Ror32(h, 6) xor Ror32(h, 11) xor Ror32(h, 25)) + ((h and a) xor ((not h) and b)) + K256[i + 5] + W[i + 5];
    g := g + cc;
    cc := cc + (Ror32(d, 2) xor Ror32(d, 13) xor Ror32(d, 22)) + ((d and e) xor (d and f) xor (e and f));
    b := b + (Ror32(g, 6) xor Ror32(g, 11) xor Ror32(g, 25)) + ((g and h) xor ((not g) and a)) + K256[i + 6] + W[i + 6];
    f := f + b;
    b := b + (Ror32(cc, 2) xor Ror32(cc, 13) xor Ror32(cc, 22)) + ((cc and d) xor (cc and e) xor (d and e));
    a := a + (Ror32(f, 6) xor Ror32(f, 11) xor Ror32(f, 25)) + ((f and g) xor ((not f) and h)) + K256[i + 7] + W[i + 7];
    e := e + a;
    a := a + (Ror32(b, 2) xor Ror32(b, 13) xor Ror32(b, 22)) + ((b and cc) xor (b and d) xor (cc and d));
    Inc(i, 8);
  end;
  Inc(C.H32[0], a); Inc(C.H32[1], b); Inc(C.H32[2], cc); Inc(C.H32[3], d);
  Inc(C.H32[4], e); Inc(C.H32[5], f); Inc(C.H32[6], g); Inc(C.H32[7], h);
end;

