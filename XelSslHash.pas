procedure HwSha512Pairs(H: PUInt64; P: PByte; Pairs: Integer);
var ctx: TSha512x2Ctx;
begin
  ctx.H := H; ctx.Data := P; ctx.Pairs := Pairs; ctx.K2 := @Sha512K2[0]; ctx.Mask := @BeQWords[0];
